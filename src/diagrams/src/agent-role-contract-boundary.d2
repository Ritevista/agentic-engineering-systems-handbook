direction: right

workflow: "Workflow" {
  shape: rectangle
}

contract: "Role contract" {
  shape: rectangle

  agent: "Agent" {
    shape: rectangle
  }
  responsibility: "Responsibility"
  inputs: "Inputs"
  actions: "Actions"
  outputs: "Outputs"
  escalation: "Escalation"
}

contract.responsibility -> contract.agent: "owns"
contract.inputs -> contract.agent: "context"
contract.agent -> contract.actions: "uses"
contract.agent -> contract.outputs: "produces"
contract.agent -> contract.escalation: "stops / hands off"

workflow -> contract.inputs: "task + context"
contract.outputs -> workflow: "artifact + evidence"
contract.escalation -> workflow: "stop / hand off"
